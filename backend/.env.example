PORT=5000
# In production on Render/Railway, set NODE_ENV=production
NODE_ENV=development

# Database connection: Replace with your MongoDB Atlas connection string for persistent cloud data:
# e.g., mongodb+srv://<username>:<password>@cluster0.mongodb.net/local_business_finder?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/local_business_finder

# Set to false in production to enforce strict connection to persistent MongoDB Atlas:
USE_IN_MEMORY_DB_FALLBACK=true

# JWT Secret (Generate a strong random 64-character secret for production)
JWT_SECRET=super_secret_local_business_finder_jwt_key_2026_dev_only
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Set to your live Vercel/Netlify frontend URL in production)
# e.g., https://local-business-finder.vercel.app
CLIENT_URL=http://localhost:3000
